<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tu cotización</title>
<style>@media only screen and (max-width:600px){.email-outer{padding:8px!important}.email-card{border-radius:0!important}.email-pad{padding:20px 16px!important}.email-title{font-size:21px!important}.item-pad{padding:12px!important}}</style></head>
<body style="margin:0;background:#f5f3ff;font-family:Arial,Helvetica,sans-serif;color:#25213a">
<table class="email-outer" role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f5f3ff;padding:24px 10px"><tr><td align="center">
  <table class="email-card" role="presentation" width="640" cellspacing="0" cellpadding="0" style="width:100%;max-width:640px;background:#fff;border:1px solid #e9e5f5;border-radius:14px;overflow:hidden">
    <tr><td class="email-pad" style="padding:24px 28px;background:#6d3bd1;color:#fff"><div style="font-size:13px;letter-spacing:1px">PEDIDOS TEMU</div><h1 class="email-title" style="margin:10px 0 0;font-size:24px">Tu cotización está lista</h1></td></tr>
    <tr><td class="email-pad" style="padding:24px 28px"><p style="font-size:16px">Hola <strong><%= cliente.nombre %></strong>,</p><p>Preparamos la cotización para tu pedido <strong>#<%= pedido.id %></strong>, con fecha <%= new Date(pedido.cotizado_en || Date.now()).toLocaleDateString('es-CR') %>.</p>
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="width:100%;border-collapse:collapse;margin:18px 0"><thead><tr><th style="padding:10px 12px;text-align:left;background:#f0eaff;color:#4b278f;font-size:14px">Artículos cotizados</th></tr></thead><tbody>
      <% articulos.forEach((a, i) => { %><tr><td class="item-pad" style="padding:12px;border-bottom:1px solid #e9e5f5"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="width:100%;border:1px solid #eeeaf6;border-radius:8px"><tr><td style="padding:12px 14px 7px"><a href="<%= a.link %>" style="color:#6033bf;font-weight:bold;text-decoration:none">Artículo <%= i + 1 %> · Abrir producto ↗</a></td></tr><tr><td style="padding:0 14px 8px;font-size:13px;color:#6b6875">Nota: <%= a.nota || 'Sin nota' %></td></tr><tr><td style="padding:0 14px 12px"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="width:100%;border-collapse:collapse;font-size:13px"><tr><td style="padding:5px 0;color:#6b6875">Cantidad</td><td style="padding:5px 0;text-align:right"><%= a.cantidad %></td></tr><tr><td style="padding:5px 0;color:#6b6875">Precio unitario</td><td style="padding:5px 0;text-align:right;white-space:nowrap"><%= dinero(a.precio_unitario, simbolo) %></td></tr><tr><td style="padding:8px 0 0;border-top:1px solid #eeeaf6;font-weight:bold">Subtotal</td><td style="padding:8px 0 0;border-top:1px solid #eeeaf6;text-align:right;font-weight:bold;white-space:nowrap"><%= dinero(a.subtotal, simbolo) %></td></tr></table></td></tr></table></td></tr><% }) %>
      </tbody></table>
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="width:100%;border-collapse:collapse"><% if (Number(pedido.envio)>0) { %><tr><td style="padding:6px 0">Envío</td><td style="padding:6px 0;text-align:right"><%= dinero(pedido.envio, simbolo) %></td></tr><% } %><% if (Number(pedido.comision)>0) { %><tr><td style="padding:6px 0">Comisión</td><td style="padding:6px 0;text-align:right"><%= dinero(pedido.comision, simbolo) %></td></tr><% } %><tr style="font-size:19px;font-weight:bold;color:#4b278f"><td style="padding:14px 0;border-top:2px solid #ddd">Total</td><td style="padding:14px 0;border-top:2px solid #ddd;text-align:right;white-space:nowrap"><%= dinero(pedido.total, simbolo) %></td></tr></table>
      <p style="margin:24px 0 16px">Entra a tu cuenta para aceptar o rechazar la cotización:</p><p style="text-align:center"><a href="<%= enlace %>" style="display:inline-block;padding:14px 22px;background:#6d3bd1;color:#fff;text-decoration:none;border-radius:8px;font-weight:bold">Ver mi pedido</a></p><p style="font-size:13px;color:#6b6875;overflow-wrap:anywhere">Si el botón no funciona, abre: <a href="<%= enlace %>" style="color:#6033bf"><%= enlace %></a></p>
    </td></tr>
  </table>
</td></tr></table></body></html>
