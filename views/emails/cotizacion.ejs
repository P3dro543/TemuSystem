<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tu cotización</title></head>
<body style="margin:0;background:#f5f3ff;font-family:Arial,Helvetica,sans-serif;color:#25213a">
<div style="max-width:640px;margin:28px auto;background:#fff;border:1px solid #e9e5f5;border-radius:14px;overflow:hidden">
  <div style="padding:24px 28px;background:#6d3bd1;color:#fff"><div style="font-size:13px;opacity:.85">PEDIDOS TEMU</div><h1 style="margin:10px 0 0;font-size:24px">Tu cotización está lista</h1></div>
  <div style="padding:26px 28px"><p style="font-size:16px">Hola <strong><%= cliente.nombre %></strong>,</p><p>Preparamos la cotización para tu pedido <strong>#<%= pedido.id %></strong>, con fecha <%= new Date(pedido.cotizado_en || Date.now()).toLocaleDateString('es-CR') %>.</p>
    <table role="presentation" style="width:100%;border-collapse:collapse;margin:20px 0;font-size:14px"><thead><tr style="background:#f5f3ff;text-align:left"><th style="padding:11px 8px">Artículo</th><th style="padding:11px 8px">Nota</th><th style="padding:11px 8px">Cant.</th><th style="padding:11px 8px;text-align:right">Precio unit.</th><th style="padding:11px 8px;text-align:right">Subtotal</th></tr></thead><tbody>
    <% articulos.forEach(a => { %><tr style="border-bottom:1px solid #eee"><td style="padding:11px 8px;word-break:break-word"><a href="<%= a.link %>" style="color:#6033bf">Ver producto</a></td><td style="padding:11px 8px"><%= a.nota || '—' %></td><td style="padding:11px 8px"><%= a.cantidad %></td><td style="padding:11px 8px;text-align:right;white-space:nowrap"><%= dinero(a.precio_unitario, simbolo) %></td><td style="padding:11px 8px;text-align:right;white-space:nowrap"><%= dinero(a.subtotal, simbolo) %></td></tr><% }) %>
    </tbody></table>
    <table role="presentation" style="width:100%;border-collapse:collapse"><% if (Number(pedido.envio)>0) { %><tr><td style="padding:6px 0">Envío</td><td style="padding:6px 0;text-align:right"><%= dinero(pedido.envio, simbolo) %></td></tr><% } %><% if (Number(pedido.comision)>0) { %><tr><td style="padding:6px 0">Comisión</td><td style="padding:6px 0;text-align:right"><%= dinero(pedido.comision, simbolo) %></td></tr><% } %><tr style="font-size:20px;font-weight:bold;color:#4b278f"><td style="padding:14px 0;border-top:2px solid #ddd">Total</td><td style="padding:14px 0;border-top:2px solid #ddd;text-align:right"><%= dinero(pedido.total, simbolo) %></td></tr></table>
    <p style="margin:26px 0 18px">Entra a tu cuenta para aceptar o rechazar la cotización:</p><p style="text-align:center"><a href="<%= enlace %>" style="display:inline-block;padding:13px 22px;background:#6d3bd1;color:#fff;text-decoration:none;border-radius:8px;font-weight:bold">Ver mi pedido</a></p><p style="font-size:13px;color:#6b6875;word-break:break-all">Si el botón no funciona, abre: <%= enlace %></p>
  </div></div></body></html>
