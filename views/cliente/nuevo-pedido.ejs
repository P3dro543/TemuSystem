<%- include('../partials/header', { titulo: 'Nuevo pedido' }) %>
<div class="page-heading"><div><div class="eyebrow">Tu lista de productos</div><h1>Crear un pedido</h1><p class="muted">Agrega un enlace de Temu por cada artículo que quieras cotizar.</p></div><a class="text-link" href="/cliente/pedidos">← Mis pedidos</a></div>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<form method="post" action="/cliente/pedidos/nuevo" class="panel stack" id="form-pedido"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div id="articulos" class="stack"><% filas.forEach((fila) => { %><div class="item-row">
    <label class="field-link">Enlace de Temu<input type="url" name="link" placeholder="https://www.temu.com/..." value="<%= fila.link || '' %>" maxlength="2048" required></label>
    <label>Cantidad<input type="number" name="cantidad" min="1" max="9999" value="<%= fila.cantidad || '1' %>" required></label>
    <label>Nota <span class="muted">(opcional)</span><input name="nota" maxlength="500" placeholder="Talla, color, modelo..." value="<%= fila.nota || '' %>"></label>
    <button class="button button-quiet quitar-fila" type="button" aria-label="Quitar artículo">Quitar</button>
  </div><% }) %></div>
  <button class="button button-secondary" type="button" id="agregar-articulo">＋ Agregar artículo</button>
  <div class="form-actions"><button class="button button-primary" type="submit">Enviar pedido</button></div>
</form><script src="/js/pedido.js" defer></script>
<%- include('../partials/footer') %>
