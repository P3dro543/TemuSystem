<%- include('../partials/header', { titulo: `Pedido #${pedido.id}` }) %>
<a class="text-link back-link" href="/cliente/pedidos">← Volver a mis pedidos</a>
<div class="page-heading"><div><div class="eyebrow">Pedido #<%= pedido.id %></div><h1>Detalle del pedido</h1><p class="muted">Creado el <%= new Date(pedido.creado_en).toLocaleDateString('es-CR') %></p></div><span class="status status-<%= pedido.estado %>"><%= etiquetasEstado[pedido.estado] %></span></div>
<section class="panel"><h2>Artículos</h2><div class="table-wrap"><table><thead><tr><th>Producto</th><th>Nota</th><th>Cantidad</th><% if (pedido.cotizado_en) { %><th>Precio unitario</th><th>Subtotal</th><% } %></tr></thead><tbody>
<% articulos.forEach(a => { %><tr><td><a href="<%= a.link %>" target="_blank" rel="noopener noreferrer" class="text-link product-link">Abrir producto ↗</a></td><td><%= a.nota || '—' %></td><td><%= a.cantidad %></td><% if (pedido.cotizado_en) { %><td><%= dinero(a.precio_unitario) %></td><td><%= dinero(a.subtotal) %></td><% } %></tr><% }) %>
</tbody></table></div></section>
<% if (pedido.cotizado_en) { %><section class="panel totals"><div class="total-row"><span>Envío</span><strong><%= dinero(pedido.envio) %></strong></div><div class="total-row"><span>Comisión</span><strong><%= dinero(pedido.comision) %></strong></div><div class="total-row total-grand"><span>Total</span><strong><%= dinero(pedido.total) %></strong></div><p class="muted">Cotizado el <%= new Date(pedido.cotizado_en).toLocaleDateString('es-CR') %>.</p></section><% } else { %><div class="alert alert-info">Tu pedido está pendiente de cotización. Te avisaremos cuando esté listo.</div><% } %>
<% if (pedido.estado === 'cotizado') { %><section class="panel response-panel"><div><h2>¿Aceptas esta cotización?</h2><p class="muted">Confirma para que podamos continuar con tu pedido.</p></div><form method="post" action="/cliente/pedidos/<%= pedido.id %>/responder" class="inline-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary" name="accion" value="aceptar">Aceptar cotización</button><button class="button button-danger-outline" name="accion" value="rechazar">Rechazar</button></form></section><% } %>
<%- include('../partials/footer') %>
