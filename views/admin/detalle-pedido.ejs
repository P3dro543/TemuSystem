<%- include('../partials/header', { titulo: `Gestionar pedido #${pedido.id}` }) %>
<a class="text-link back-link" href="/admin/pedidos">← Volver a pedidos</a>
<div class="page-heading"><div><div class="eyebrow">Pedido #<%= pedido.id %></div><h1>Gestionar pedido</h1><p class="muted">Creado el <%= new Date(pedido.creado_en).toLocaleDateString('es-CR') %></p></div><span class="status status-<%= pedido.estado %>"><%= etiquetasEstado[pedido.estado] %></span></div>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<section class="panel customer-card"><div><div class="eyebrow">Cliente</div><h2><%= pedido.cliente %></h2></div><div><a class="text-link" href="mailto:<%= pedido.correo %>"><%= pedido.correo %></a><div class="muted"><%= pedido.telefono || 'Sin teléfono' %></div></div></section>
<form method="post" action="/admin/pedidos/<%= pedido.id %>/cotizar" class="panel stack" id="form-cotizar">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><h2>Artículos y precios</h2><p class="muted">Asigna un precio unitario a cada artículo.</p></div>
<div class="table-wrap"><table><thead><tr><th>Producto</th><th>Nota</th><th>Cantidad</th><th>Precio unitario</th></tr></thead><tbody>
<% articulos.forEach(a => { %><tr><td><a href="<%= a.link %>" target="_blank" rel="noopener noreferrer" class="text-link product-link">Abrir producto ↗</a></td><td><%= a.nota || '—' %></td><td><%= a.cantidad %></td><td><label class="price-field"><span>Precio</span><input type="number" name="precio_unitario" min="0" max="9999999999.99" step="0.01" value="<%= a.precio_unitario == null ? '' : Number(a.precio_unitario).toFixed(2) %>" required data-cantidad="<%= a.cantidad %>"></label></td></tr><% }) %>
</tbody></table></div>
<div class="cost-grid"><label>Envío<input type="number" name="envio" min="0" step="0.01" max="9999999999.99" value="<%= Number(pedido.envio || 0).toFixed(2) %>" data-cargo required></label><label>Comisión<input type="number" name="comision" min="0" step="0.01" max="9999999999.99" value="<%= Number(pedido.comision || 0).toFixed(2) %>" data-cargo required></label><div class="live-total"><span>Total estimado</span><strong id="total-vivo"><%= dinero(pedido.total) %></strong></div></div>
<% if (['pendiente','cotizado'].includes(pedido.estado)) { %><div class="form-actions"><button class="button button-primary" type="submit"><%= pedido.estado === 'cotizado' ? 'Guardar y reenviar cotización' : 'Guardar y enviar cotización' %></button></div><% } %></form>
<% if (pedido.estado === 'cotizado') { %><form method="post" action="/admin/pedidos/<%= pedido.id %>/reenviar" class="inline-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-secondary" type="submit">Reenviar correo de cotización</button></form><% } %>
<% if (pedido.estado === 'aceptado') { %><form method="post" action="/admin/pedidos/<%= pedido.id %>/estado" class="panel inline-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="estado" value="comprado"><p>El cliente aceptó esta cotización.</p><button class="button button-primary" type="submit">Marcar como comprado</button></form><% } %>
<% if (pedido.estado === 'comprado') { %><form method="post" action="/admin/pedidos/<%= pedido.id %>/estado" class="panel inline-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="estado" value="entregado"><p>Confirma cuando hayas entregado el pedido.</p><button class="button button-primary" type="submit">Marcar como entregado</button></form><% } %>
<% if (pedido.cotizado_en) { %><section class="panel totals"><div class="total-row"><span>Envío</span><strong><%= dinero(pedido.envio) %></strong></div><div class="total-row"><span>Comisión</span><strong><%= dinero(pedido.comision) %></strong></div><div class="total-row total-grand"><span>Total guardado</span><strong><%= dinero(pedido.total) %></strong></div></section><% } %>
<script src="/js/admin-cotizar.js" defer></script><%- include('../partials/footer') %>
