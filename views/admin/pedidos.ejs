<%- include('../partials/header', { titulo: 'Pedidos' }) %>
<div class="page-heading"><div><div class="eyebrow">Panel de administración</div><h1>Pedidos</h1><p class="muted">Revisa los pedidos y prepara sus cotizaciones.</p></div></div>
<form class="filter-bar panel order-filter-bar" method="get" action="/admin/pedidos"><label>Buscar cliente<input name="buscar" value="<%= buscar %>" maxlength="120" placeholder="Nombre o correo"></label><label>Estado<select name="estado"><option value="">Todos los estados</option><% Object.entries(etiquetasEstado).forEach(([clave, etiqueta]) => { %><option value="<%= clave %>" <%= estado === clave ? 'selected' : '' %>><%= etiqueta %></option><% }) %></select></label><label>Desde<input type="date" name="desde" value="<%= desde %>"></label><label>Hasta<input type="date" name="hasta" value="<%= hasta %>"></label><button class="button button-primary" type="submit">Filtrar</button><% if (estado || buscar || desde || hasta) { %><a class="button button-quiet" href="/admin/pedidos">Limpiar</a><% } %></form>
<p class="muted result-count"><%= total %> pedido<%= total === 1 ? '' : 's' %> encontrado<%= total === 1 ? '' : 's' %>.</p>
<% if (!pedidos.length) { %><section class="empty-state"><div class="empty-icon">⌕</div><h2>No hay pedidos</h2><p>Los pedidos nuevos aparecerán en esta lista.</p></section><% } else { %><div class="table-wrap"><table><thead><tr><th>Pedido</th><th>Cliente</th><th>Correo</th><th>Fecha</th><th>Estado</th><th>Total</th><th></th></tr></thead><tbody>
<% pedidos.forEach(p => { %><tr><td class="strong">#<%= p.id %></td><td><%= p.cliente %></td><td><%= p.correo %></td><td><%= new Date(p.creado_en).toLocaleDateString('es-CR') %></td><td><span class="status status-<%= p.estado %>"><%= etiquetasEstado[p.estado] %></span></td><td><%= ['cotizado','aceptado','rechazado','comprado','entregado'].includes(p.estado) ? dinero(p.total) : '—' %></td><td><a class="text-link" href="/admin/pedidos/<%= p.id %>">Gestionar →</a></td></tr><% }) %>
</tbody></table></div>
<% if (paginas > 1) { %><nav class="pagination" aria-label="Paginación de pedidos">
  <% if (pagina > 1) { %><a class="button button-quiet" href="/admin/pedidos?buscar=<%= encodeURIComponent(buscar) %>&amp;estado=<%= encodeURIComponent(estado) %>&amp;desde=<%= encodeURIComponent(desde) %>&amp;hasta=<%= encodeURIComponent(hasta) %>&amp;pagina=<%= pagina - 1 %>">← Anterior</a><% } %>
  <span>Página <%= pagina %> de <%= paginas %></span>
  <% if (pagina < paginas) { %><a class="button button-quiet" href="/admin/pedidos?buscar=<%= encodeURIComponent(buscar) %>&amp;estado=<%= encodeURIComponent(estado) %>&amp;desde=<%= encodeURIComponent(desde) %>&amp;hasta=<%= encodeURIComponent(hasta) %>&amp;pagina=<%= pagina + 1 %>">Siguiente →</a><% } %>
</nav><% } %><% } %>
<%- include('../partials/footer') %>
