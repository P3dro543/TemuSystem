<%- include('../partials/header', { titulo: 'Usuarios' }) %>
<div class="page-heading"><div><div class="eyebrow">Panel de administración</div><h1>Usuarios</h1><p class="muted">Cuentas registradas en Pedidos Temu: <strong><%= total %></strong>. Puedes editar datos y roles; las cuentas con pedidos conservan su historial.</p></div><a class="text-link" href="/admin/pedidos">← Volver a pedidos</a></div>

<form class="filter-bar panel" method="get" action="/admin/usuarios">
  <label>Buscar por nombre o correo<input name="buscar" value="<%= buscar %>" maxlength="120" placeholder="Nombre o correo"></label>
  <label>Tipo de cuenta<select name="rol"><option value="">Todos los roles</option><option value="cliente" <%= rol === 'cliente' ? 'selected' : '' %>>Cliente</option><option value="admin" <%= rol === 'admin' ? 'selected' : '' %>>Administrador</option></select></label>
  <label>Estado<select name="activo"><option value="">Activas e inactivas</option><option value="true" <%= activo === 'true' ? 'selected' : '' %>>Activas</option><option value="false" <%= activo === 'false' ? 'selected' : '' %>>Desactivadas</option></select></label>
  <button class="button button-primary" type="submit">Buscar</button>
  <% if (buscar || rol || activo) { %><a class="button button-quiet" href="/admin/usuarios">Limpiar</a><% } %>
</form>

<% if (!usuarios.length) { %>
  <section class="empty-state"><div class="empty-icon">⌕</div><h2>No hay usuarios con esos filtros</h2><p>Prueba con otro nombre, correo o tipo de cuenta.</p></section>
<% } else { %>
  <div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Correo</th><th>Teléfono</th><th>Rol</th><th>Estado</th><th>Pedidos</th><th>Registro</th><th>Acciones</th></tr></thead><tbody>
    <% usuarios.forEach(u => { %><tr>
      <td class="strong"><%= u.nombre %></td><td><%= u.correo %></td><td><%= u.telefono || '—' %></td>
      <td><span class="user-role user-role-<%= u.rol %>"><%= u.rol === 'admin' ? 'Administrador' : 'Cliente' %></span></td>
      <td><span class="user-active <%= u.activo ? 'is-active' : 'is-inactive' %>"><%= u.activo ? 'Activa' : 'Desactivada' %></span></td>
      <td><%= u.cantidad_pedidos %></td><td><%= new Date(u.creado_en).toLocaleDateString('es-CR') %></td>
      <td><div class="user-actions"><a class="button button-quiet button-small" href="/admin/usuarios/<%= u.id %>/editar">Editar</a>
        <% if (String(usuario.id) === String(u.id)) { %><span class="muted">Tu cuenta</span>
        <% } else { %><form method="post" action="/admin/usuarios/<%= u.id %>/estado" data-confirm="¿<%= u.activo ? 'Desactivar' : 'Reactivar' %> la cuenta de <%= u.nombre %>? <%= u.activo ? 'Se cerrarán sus sesiones y no podrá iniciar sesión.' : 'La persona podrá volver a iniciar sesión.' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="activo" value="<%= u.activo ? 'false' : 'true' %>"><button class="button <%= u.activo ? 'button-danger-outline' : 'button-secondary' %> button-small" type="submit"><%= u.activo ? 'Desactivar' : 'Reactivar' %></button></form><% } %>
      </div></td>
    </tr><% }) %>
  </tbody></table></div>
  <% if (paginas > 1) { %><nav class="pagination" aria-label="Paginación de usuarios">
    <% if (pagina > 1) { %><a class="button button-quiet" href="/admin/usuarios?buscar=<%= encodeURIComponent(buscar) %>&amp;rol=<%= encodeURIComponent(rol) %>&amp;activo=<%= encodeURIComponent(activo) %>&amp;pagina=<%= pagina - 1 %>">← Anterior</a><% } %>
    <span>Página <%= pagina %> de <%= paginas %></span>
    <% if (pagina < paginas) { %><a class="button button-quiet" href="/admin/usuarios?buscar=<%= encodeURIComponent(buscar) %>&amp;rol=<%= encodeURIComponent(rol) %>&amp;activo=<%= encodeURIComponent(activo) %>&amp;pagina=<%= pagina + 1 %>">Siguiente →</a><% } %>
</nav><% } %>
<% } %>
<script src="/js/admin-usuarios.js" defer></script>
<%- include('../partials/footer') %>
