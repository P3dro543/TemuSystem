<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#7c3aed"><title><%= titulo || 'Pedidos Temu' %> | Pedidos Temu</title>
  <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
<header class="site-header"><div class="header-inner">
  <a class="brand" href="/"><span class="brand-mark">T</span><span>Pedidos Temu</span></a>
  <% if (usuario) { %><nav aria-label="Navegación principal">
    <% if (usuario.rol === 'admin') { %><a href="/admin/pedidos">Pedidos</a><a href="/admin/usuarios">Usuarios</a><% } else { %><a href="/cliente/pedidos/nuevo">Nuevo pedido</a><a href="/cliente/pedidos">Mis pedidos</a><% } %>
    <form class="nav-form" method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="nav-button" type="submit">Salir</button></form>
  </nav><% } %>
</div></header>
<main class="container">
  <% if (mensaje) { %><div class="alert alert-<%= mensaje.tipo %>" role="status"><%= mensaje.texto %></div><% } %>
